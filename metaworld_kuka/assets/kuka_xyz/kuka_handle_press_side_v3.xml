<mujoco model="kuka_handle_press_side_v3">
    <include file="../objects/assets/kuka_xyz_base_dependencies.xml"/>
    <asset>
        <texture name="T_hdlprsmetal0" type="cube"
                 file="../../../metaworld/assets/textures/metal1.png"/>
        <material name="hdlprs_col" rgba="0.3 0.3 1.0 0.5" shininess="0" specular="0"/>
        <material name="hdlprs_red" rgba=".5 0 0 1" shininess="1" reflectance=".7" specular=".5"/>
        <material name="hdlprs_black" rgba=".15 .15 .15 1" shininess="1" reflectance=".7" specular=".5"/>
        <material name="hdlprs_metal0" rgba=".55 .55 .55 1" texture="T_hdlprsmetal0"
                  shininess="1" reflectance=".7" specular=".5"/>
        <mesh name="handle_press_base"
              file="../../../metaworld/assets/objects/meshes/handle_press/handle_press_base.stl"/>
        <mesh name="handle_press_col1"
              file="../../../metaworld/assets/objects/meshes/handle_press/handle_press_col1.stl"/>
        <mesh name="handle_press_col2"
              file="../../../metaworld/assets/objects/meshes/handle_press/handle_press_col2.stl"/>
        <mesh name="handle_press_col3"
              file="../../../metaworld/assets/objects/meshes/handle_press/handle_press_col3.stl"/>
        <mesh name="handle_press_grip"
              file="../../../metaworld/assets/objects/meshes/handle_press/handle_press_grip.stl"/>
        <mesh name="handle_press_lever"
              file="../../../metaworld/assets/objects/meshes/handle_press/handle_press_lever.stl"/>
        <mesh name="handle_press_trim"
              file="../../../metaworld/assets/objects/meshes/handle_press/handle_press_trim.stl"/>
    </asset>
    <default>
        <default class="hdlprs_base">
            <joint armature="0.001" damping="2" limited="true"/>
            <geom conaffinity="0" contype="0" group="1" type="mesh"/>
            <default class="hdlprs_col">
                <geom conaffinity="1" condim="3" contype="0" group="4"
                      material="hdlprs_col" solimp="0.99 0.99 0.01" solref="0.01 1"/>
            </default>
        </default>
    </default>
    <option timestep="0.0025" iterations="50" tolerance="1e-10"
            solver="Newton" jacobian="dense" cone="elliptic"/>
    <visual>
        <global offwidth="480" offheight="480"/>
        <headlight ambient="0.4 0.4 0.4"/>
    </visual>
    <worldbody>
        <light directional="true" diffuse="0.6 0.6 0.6" pos="-1 -1 1" dir="1 1 -1"/>
        <camera name="corner" pos="1.1 -0.7 1.1" xyaxes="0.55 0.83 0 -0.45 0.30 0.84"/>
        <geom name="floor" type="plane" size="2 2 0.1" rgba="0.8 0.8 0.8 1"/>
        <include file="../objects/assets/kuka_xyz_base.xml"/>
        <body name="box" euler="0 0 -1.57" pos="0.22 0.52 0">
            <body childclass="hdlprs_base" name="hdlprs">
                <geom material="hdlprs_metal0" mesh="handle_press_base"/>
                <geom material="hdlprs_black" euler="0 1.57 0" mesh="handle_press_trim"/>
                <geom class="hdlprs_col" euler="0 1.57 0" mesh="handle_press_col1" pos="0.055 0 0"/>
                <geom class="hdlprs_col" euler="0 1.57 0" mesh="handle_press_col2" pos="-0.066 0 0"/>
                <geom class="hdlprs_col" euler="0 1.57 0" mesh="handle_press_col3" pos="-0.009 0 0"/>
                <geom class="hdlprs_col" pos="0 -0.082 0.014" size="0.035 0.028 0.014" type="box"/>
                <body name="handle_link" pos="0 -0.05 0.15">
                    <joint name="goal_slidez" type="slide" axis="0 0 1" range="-.1 0"
                           damping="30" stiffness="500" springref="0" limited="true"/>
                    <site name="handleStart" pos="0 -0.166 0.022" size="0.005" rgba="0.8 0 0 1"/>
                    <geom material="hdlprs_red" euler="0 1.57 0" mesh="handle_press_grip" pos="0 -0.166 0"/>
                    <geom material="hdlprs_black" mesh="handle_press_lever" pos="0 -0.089 0"/>
                    <geom class="hdlprs_col" pos="0 -0.081 0" size="0.032 0.075 0.011" type="box" mass=".001"/>
                    <geom class="hdlprs_col" euler="0 1.57 0" pos="0 -0.166 0"
                          size="0.022 0.07" type="cylinder" mass=".001"/>
                </body>
            </body>
            <site name="goalPress" pos="0 -0.216 0.075" size="0.005" rgba="1 1 1 1"/>
            <site name="goalPull" pos="0 -0.216 0.172" size="0.005" rgba="0 0 0 1"/>
        </body>
    </worldbody>
    <equality>
        <weld name="mocap_to_hand" body1="mocap" body2="hand" solref="0.02 1"/>
    </equality>
</mujoco>

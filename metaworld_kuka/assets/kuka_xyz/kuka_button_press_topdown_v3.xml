<mujoco model="kuka_button_press_topdown_v3">
    <include file="../objects/assets/kuka_xyz_base_dependencies.xml"/>
    <asset>
        <texture name="T_btn" type="cube" file="../../../metaworld/assets/textures/metal1.png"/>
        <material name="btn_col" rgba="0.3 0.3 1.0 0.5" shininess="0" specular="0"/>
        <material name="btn_red" rgba=".6 0 0 1" shininess="1" reflectance=".7" specular=".5"/>
        <material name="btn_yellow" rgba=".7 .5 0 1" shininess="1" reflectance=".7" specular=".5"/>
        <material name="btn_black" rgba=".15 .15 .15 1" shininess="1" reflectance=".7" specular=".5"/>
        <material name="btn_metal" rgba=".8 .8 .8 1" texture="T_btn" shininess="1" reflectance="1" specular="1"/>
        <mesh name="stopbot" file="../../../metaworld/assets/objects/meshes/buttonbox/stopbot.stl"/>
        <mesh name="stopbutton" file="../../../metaworld/assets/objects/meshes/buttonbox/stopbutton.stl"/>
        <mesh name="stopbuttonrim" file="../../../metaworld/assets/objects/meshes/buttonbox/stopbuttonrim.stl"/>
        <mesh name="stopbuttonrod" file="../../../metaworld/assets/objects/meshes/buttonbox/stopbuttonrod.stl"/>
        <mesh name="stoptop" file="../../../metaworld/assets/objects/meshes/buttonbox/stoptop.stl"/>
    </asset>
    <default>
        <default class="buttonbox_base">
            <joint armature="0.001" damping="2" limited="true"/>
            <geom conaffinity="0" contype="0" group="1" type="mesh"/>
            <default class="buttonbox_col"><geom conaffinity="1" condim="3" contype="1" group="4" material="btn_col" solimp="0.99 0.99 0.01" solref="0.01 1"/></default>
        </default>
    </default>
    <option timestep="0.0025" iterations="50" tolerance="1e-10" solver="Newton" jacobian="dense" cone="elliptic"/>
    <visual><global offwidth="480" offheight="480"/><headlight ambient="0.4 0.4 0.4"/></visual>
    <worldbody>
        <light directional="true" diffuse="0.6 0.6 0.6" pos="-1 -1 1" dir="1 1 -1"/>
        <camera name="corner" pos="1.1 -0.7 1.1" xyaxes="0.55 0.83 0 -0.45 0.30 0.84"/>
        <geom name="floor" type="plane" size="2 2 0.1" rgba="0.8 0.8 0.8 1"/>
        <include file="../objects/assets/kuka_xyz_base.xml"/>
        <body name="box" euler="-1.57079632679 0 0" pos="0 0.59 0.115">
            <body childclass="buttonbox_base" name="buttonbox">
                <geom material="btn_black" mesh="stopbot" pos="0 -0.06 0"/>
                <geom material="btn_metal" euler="1.57 0 0" mesh="stopbuttonrim" pos="0 -0.089 0"/>
                <geom material="btn_yellow" mesh="stoptop" pos="0 -0.06 0"/>
                <geom class="buttonbox_col" pos="0 0.012 0.072" size="0.12 0.102 0.048" type="box"/>
                <geom class="buttonbox_col" pos="0 0.012 -0.072" size="0.12 0.102 0.048" type="box"/>
                <geom class="buttonbox_col" pos="-0.073 0.012 0" size="0.047 0.102 0.024" type="box"/>
                <geom class="buttonbox_col" pos="0.073 0.012 0" size="0.047 0.102 0.024" type="box"/>
                <body childclass="buttonbox_base" name="button">
                    <inertial pos="0 -0.1935 0" mass=".01" diaginertia="0.001 0.001 0.001"/>
                    <joint name="btnbox_joint" axis="0 -1 0" type="slide" springref=".5" limited="true" stiffness="0.5" range="-0.075 0" damping="1"/>
                    <geom name="btnGeom" material="btn_red" euler="1.57 0 0" mesh="stopbutton" pos="0 -0.158 0"/>
                    <geom material="btn_black" euler="1.57 0 0" mesh="stopbuttonrod" pos="0 -0.126 0"/>
                    <geom class="buttonbox_col" euler="1.57 0 0" pos="0 -0.128 0" size="0.021 0.039" type="cylinder"/>
                    <geom class="buttonbox_col" euler="1.57 0 0" pos="0 -0.166 0" size="0.026 0.008" type="cylinder"/>
                    <geom class="buttonbox_col" euler="1.57 0 0" pos="0 -0.183 0" size="0.043 0.011" type="cylinder"/>
                    <site name="buttonStart" pos="0 -0.1935 0" size="0.005" rgba="0 0.8 0 1"/>
                </body>
            </body>
            <site name="hole" pos="0 -0.1 0" size="0.005" rgba="0 0.8 0 1"/>
        </body>
    </worldbody>
    <equality><weld name="mocap_to_hand" body1="mocap" body2="hand" solref="0.02 1"/></equality>
</mujoco>
